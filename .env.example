OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5-mini
API_PORT=3001

# Kefi V2 feature flags. Leave disabled until the matching implementation plan is complete.
KEFI_FLAG_SHELL=false
KEFI_FLAG_CALORIE_LAB=false
KEFI_FLAG_SCAN=false
KEFI_FLAG_PANTRY=false
KEFI_FLAG_GROCERY=false
KEFI_FLAG_RESTAURANT=false
KEFI_FLAG_PROGRESS=false
KEFI_FLAG_ACCOUNTS=false
KEFI_FLAG_PROACTIVE=false

# Browser-side flag (Create React App only exposes REACT_APP_* variables). Enables the Kefi shell preview.
REACT_APP_KEFI_FLAG_SHELL=false
